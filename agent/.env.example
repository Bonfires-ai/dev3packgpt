LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# Optional - Falls back to a default voice
ELEVEN_VOICE_ID=
SMALLEST_API_KEY=

# No OpenRouter key here: the client dispatches the agent with the signed-in
# member's key. Optional – must match the client's LIVEKIT_AGENT_NAME.
# LIVEKIT_AGENT_NAME=solene

# Optional – Devfolio analytics (leave blank to skip)
DATALAYER_BASE_URL=
DATALAYER_API_KEY=

# Bonfires Knowledge Graph – powers the persona's dynamic knowledge retrieval
BONFIRES_API_KEY=
BONFIRES_BONFIRE_ID=
# Optional – override the default API URL
# BONFIRES_API_URL=https://tnt-v2-staging.api.bonfires.ai

# Bonfires MCP server (dev3pack-mcp/mcp-server) — the agent's knowledge tools.
# The key is one of the server's MCP_API_KEYS. Unset URL = no knowledge tools.
BONFIRES_MCP_URL=https://dev3pack-mcp.bonfires.ai/mcp
BONFIRES_MCP_KEY=

# Optional – TTS when ELEVEN_API_KEY is unset (OpenRouter, on the member's key)
# OPENROUTER_TTS_MODEL=x-ai/grok-voice-tts-1.0
# OPENROUTER_TTS_VOICE=eve
# Spanish sessions read the dev3pack-es instance instead.
BONFIRES_MCP_URL_ES=https://dev3pack-es-mcp.bonfires.ai/mcp
BONFIRES_MCP_KEY_ES=
