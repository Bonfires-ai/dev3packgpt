# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY="<your_api_key>"
LIVEKIT_API_SECRET="<your_api_secret>"
LIVEKIT_URL="wss://<project-subdomain>.livekit.cloud"

# Infura Secrets for IPFS Upload (required only when Zora minting is enabled)
INFURA_API_KEY=""
INFURA_API_SECRET=""

# Reown AppKit Project ID (required only when Zora minting is enabled)
NEXT_PUBLIC_PROJECT_ID=""

# Set to "false" to disable Zora minting flow (hides wallet connect + coin button)
NEXT_PUBLIC_ENABLE_ZORA_MINTING=true

# x402 payments (optional)
VOICE_SESSION_JWT_SECRET=""
NEXT_PUBLIC_DELVE_API_URL="https://api.delve.bonfires.xyz/"

# Free-session toggle — set to "true" to skip wallet + payment entirely
# (the payment gate becomes a single "Start Session" button that mints a JWT).
# Useful for demos, workshops, or pre-launch testing. Leave unset for production.
NEXT_PUBLIC_DISABLE_X402="false"

# === Optional overrides (sensible defaults) ===
NEXT_PUBLIC_PAYMENT_NETWORK="base"                  # Default: base
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"  # USDC on Base
NEXT_PUBLIC_CHAIN_ID="8453"                         # Base mainnet
NEXT_PUBLIC_PAYMENT_DEFAULT_AMOUNT="1.00"           # Session price in USD
# Salts text agents (optional). One key per agent in config/salts.config.ts,
# named SALTS_AGENT_KEY_<SLUG> with the slug upper-cased and dashes as underscores.
SALTS_API_URL="https://api.salts.dev"
SALTS_AGENT_KEY_GENERAL_ASSISTANT=""
