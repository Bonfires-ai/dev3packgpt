# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY="<your_api_key>"
LIVEKIT_API_SECRET="<your_api_secret>"
LIVEKIT_URL="wss://<project-subdomain>.livekit.cloud"

# Infura Secrets for IPFS Upload (required only when Zora minting is enabled)
INFURA_API_KEY=""
INFURA_API_SECRET=""

# Reown AppKit Project ID (required only when Zora minting is enabled)
NEXT_PUBLIC_PROJECT_ID=""

# Set to "false" to disable Zora minting flow (hides wallet connect + coin button)
NEXT_PUBLIC_ENABLE_ZORA_MINTING=true

# x402 payments (optional)
VOICE_SESSION_JWT_SECRET=""
NEXT_PUBLIC_DELVE_API_URL="https://api.delve.bonfires.xyz/"

# Free-session toggle — set to "true" to skip wallet + payment entirely
# (the payment gate becomes a single "Start Session" button that mints a JWT).
# Useful for demos, workshops, or pre-launch testing. Leave unset for production.
NEXT_PUBLIC_DISABLE_X402="false"

# === Optional overrides (sensible defaults) ===
NEXT_PUBLIC_PAYMENT_NETWORK="base"                  # Default: base
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"  # USDC on Base
NEXT_PUBLIC_CHAIN_ID="8453"                         # Base mainnet
NEXT_PUBLIC_PAYMENT_DEFAULT_AMOUNT="1.00"           # Session price in USD
# Salts text chat: each member talks to their own fleet agent with their sign-in's
# access token, so Salts must list this app's OAuth client id in OAUTH_CLIENTS.
# Tokens are kept in Supabase (run db/salts.sql once).
SALTS_API_URL="https://api.salts.dev"
# SALTS_OAUTH_RESOURCE="https://api.salts.dev"     # Default: SALTS_API_URL; Salts' OAUTH_RESOURCE

# === Sign-in (required) ===
# Visitors sign in with the Salts Clerk instance (OAuth) and must have an agent in
# this Salts fleet, the same check the dev3pack MCP server does.
SALTS_FLEET_ID=""
SALTS_FLEET_KEY=""
# Signs the session cookie. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=""
# OAUTH_ISSUER="https://clerk.salts.dev"            # Default
# The OAuth client id defaults to <origin>/oauth/client-metadata.json, which Clerk
# must fetch over https. For local dev, point it at a deployed copy and list the
# localhost callback there via AUTH_EXTRA_REDIRECT_URIS on that deployment.
# CLERK_OAUTH_CLIENT_ID="https://dev3pack.xyz/oauth/client-metadata.json"
# CLERK_OAUTH_CLIENT_SECRET=""                      # Only for a Clerk-dashboard OAuth app
# AUTH_EXTRA_REDIRECT_URIS="http://localhost:3000/api/auth/callback"
# AUTH_PUBLIC_URL=""                                # Public origin when behind a proxy

# === OpenRouter wallet (required) ===
# Each fleet member gets an OpenRouter key on first sign-in; the voice agent spends
# from it. Keys are stored encrypted in Supabase Postgres (run db/wallet.sql once).
DATABASE_URL=""                                     # Supabase pooler connection string
OPENROUTER_PROVISIONING_KEY=""
OPENROUTER_KEY_CREDIT_USD="0.5"                    # Credit limit per member key
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=""
# LIVEKIT_AGENT_NAME="dev3pack_instructor"         # Default; must match the agent's

# "Buy credits" tops up a member's key over x402 (USDC on Solana), always paid,
# whatever NEXT_PUBLIC_DISABLE_X402 says. Packs and fee: config/credits.config.ts.
NEXT_PUBLIC_SOLANA_NETWORK="devnet"                # devnet | mainnet
NEXT_PUBLIC_SOLANA_RPC_URL=""
SOLANA_RPC_URL=""
SOLANA_RECIPIENT_ADDRESS=""                        # Where the USDC lands
X402_FACILITATOR="self"                            # self | coinbase
FACILITATOR_KEYPAIR_SECRET=""                      # Base58; pays Solana tx fees (self)
